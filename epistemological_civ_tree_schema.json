{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/epistemological-civ-tree.schema.json",
  "title": "Epistemological Civ Tree Graph",
  "type": "object",
  "required": [
    "schema_version",
    "graph",
    "nodes",
    "edges",
    "progression"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "graph": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "layer",
          "stage",
          "stageScope",
          "progressionRole"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type",
          "weight",
          "transitionClass",
          "stageDelta"
        ],
        "properties": {
          "explanation": {
            "description": "One or two plain-language sentences on why the source leads to the target. Required for every edge walked by a cycle or tour; reused by tours and the inspector.",
            "type": "string"
          }
        }
      }
    },
    "stateEffects": {
      "type": "array"
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "nodes",
          "edgeIds",
          "description"
        ],
        "properties": {
          "edgeIds": {
            "description": "Ordered edge IDs forming a directed walk; the walk may be a closed cycle or an incomplete narrative trace when the graph has a data gap.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tours": {
      "description": "Authored tours: ordered edge IDs forming a directed walk over existing edges, from a starting argument or pressure to where it settles.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label",
          "edgeIds",
          "description"
        ],
        "properties": {
          "kind": {
            "description": "argument: authored path from an argument or pressure to where it settles. journey: longest simple path from a starting node to a terminal worldview state. return: authored walk that leaves a position under friction and comes back to it, so it revisits at least one concept.",
            "enum": ["argument", "journey", "return"]
          },
          "edgeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "attractors": {
      "type": "array"
    },
    "progression": {
      "type": "object"
    }
  }
}
